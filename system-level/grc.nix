# grc.nix — Generic Colouriser (grc) for all users.
# Provides colorised terminal output for supported system commands.
{pkgs, ...}: {
  environment.systemPackages = [ pkgs.grc ];

  # Enable grc aliases for all users via a system-wide profile script.
  environment.etc."profile.d/grc-aliases.sh".text = ''
    # Generic Colouriser (grc) aliases — applied to all users
    if [ -n "''${TERM:-}" ] && [ "$TERM" != "dumb" ] && [ -t 1 ]; then
      GRC="${pkgs.grc}/bin/grc"
      if [ -x "$GRC" ]; then
        alias colourify="$GRC -es --colour=auto"
        alias blkid='colourify blkid'
        alias configure='colourify ./configure'
        alias df='colourify df'
        alias docker='colourify docker'
        alias docker-compose='colourify docker-compose'
        alias docker-machine='colourify docker-machine'
        alias du='colourify du'
        alias free='colourify free'
        alias fdisk='colourify fdisk'
        alias findmnt='colourify findmnt'
        alias make='colourify make'
        alias gcc='colourify gcc'
        alias g++='colourify g++'
        alias id='colourify id'
        alias ip='colourify ip'
        alias iptables='colourify iptables'
        alias as='colourify as'
        alias gas='colourify gas'
        alias journalctl='colourify journalctl'
        alias kubectl='colourify kubectl'
        alias ld='colourify ld'
        alias lsof='colourify lsof'
        alias lsblk='colourify lsblk'
        alias lspci='colourify lspci'
        alias netstat='colourify netstat'
        alias ping='colourify ping'
        alias ss='colourify ss'
        alias traceroute='colourify traceroute'
        alias traceroute6='colourify traceroute6'
        alias head='colourify head'
        alias tail='colourify tail'
        alias dig='colourify dig'
        alias mount='colourify mount'
        alias ps='colourify ps'
        alias mtr='colourify mtr'
        alias semanage='colourify semanage'
        alias getsebool='colourify getsebool'
        alias ifconfig='colourify ifconfig'
        alias sockstat='colourify sockstat'
        alias nmap='colourify nmap'
        alias uptime='colourify uptime'
        alias w='colourify w'
        alias who='colourify who'
        alias last='colourify last'
        alias dnf='colourify dnf'
        alias yum='colourify yum'
        alias apt='colourify apt'
        alias apt-get='colourify apt-get'
        alias emerge='colourify emerge'
        alias pacman='colourify pacman'
        alias lsmod='colourify lsmod'
        alias ldd='colourify ldd'
        alias env='colourify env'
        alias stat='colourify stat'
        alias whoami='colourify whoami'
        alias uname='colourify uname'
        alias sysctl='colourify sysctl'
        alias systemctl='colourify systemctl'
        alias iostat='colourify iostat'
        alias sar='colourify sar'
        alias vmstat='colourify vmstat'
        alias mpstat='colourify mpstat'
        alias pidstat='colourify pidstat'
        alias iotop='colourify iotop'
        alias route='colourify route'
        alias nstat='colourify nstat'
        alias lnstat='colourify lnstat'
        alias tc='colourify tc'
        alias bridge='colourify bridge'
        alias arp='colourify arp'
        alias neigh='colourify neigh'
        alias objdump='colourify objdump'
        alias readelf='colourify readelf'
        alias strings='colourify strings'
        alias nm='colourify nm'
        alias size='colourify size'
      fi
    fi
  '';
}
