  autocmd BufRead,BufNewFile *.j2
        \ if &ft ==# '' || &ft ==# 'jinja' |
        \   execute 'doautocmd filetypedetect BufRead ' . fnameescape(expand('<afile>:r')) |
        \ endif
augroup END

" Inline fallback syntax for Nix, used only if Vim's runtime has none
function! s:NixSyntax() abort
  if exists('b:current_syntax') | return | endif
  syntax keyword nixTodo TODO FIXME XXX contained
  syntax keyword nixKeyword let in if then else rec with inherit assert or import
  syntax keyword nixBoolean true false null
  syntax keyword nixBuiltin builtins abort throw toString map filter derivation
  syntax match   nixNumber  /\<\d\+\(\.\d\+\)\=\>/
  syntax match   nixAttr    /\<[A-Za-z_][A-Za-z0-9_'-]*\ze\s*=\([^=]\|$\)/
  syntax match   nixPath    @\(\~\|\.\.\=\)\=/[A-Za-z0-9._+/-]\+@
  syntax match   nixPath    @<[A-Za-z0-9._/-]\+>@
  syntax match   nixUri     @https\=://[^ ;)\]"]*@
  syntax match   nixOperator @\(++\|//\|->\|&&\|||\|!=\|==\)@
  syntax match   nixEscape  +\\.+ contained
  syntax region  nixInterp  matchgroup=nixInterpDelim start=+\${+ end=+}+ contained contains=TOP
  syntax region  nixString  start=+"+ skip=+\\"+ end=+"+ contains=nixInterp,nixEscape
  syntax region  nixIndString start=+''+ skip=+'''\|''\$\|''\\.+ end=+''+ contains=nixInterp
  syntax match   nixComment /#.*$/ contains=nixTodo
  syntax region  nixComment start=+/\*+ end=+\*/+ contains=nixTodo
  highlight default link nixKeyword     Keyword
  highlight default link nixBoolean     Boolean
  highlight default link nixBuiltin     Function
  highlight default link nixNumber      Number
  highlight default link nixAttr        Identifier
  highlight default link nixPath        Special
  highlight default link nixUri         Underlined
  highlight default link nixOperator    Operator
  highlight default link nixEscape      SpecialChar
  highlight default link nixInterpDelim PreProc
  highlight default link nixString      String
  highlight default link nixIndString   String
  highlight default link nixComment     Comment
  highlight default link nixTodo        Todo
  let b:current_syntax = 'nix'
endfunction

" Inline jinja markers for Ansible yaml
function! s:AnsibleSyntax() abort
  syntax match ansibleJinjaExpr    /{{.\{-}}}/  containedin=ALL
  syntax match ansibleJinjaStmt    /{%.\{-}%}/  containedin=ALL
  syntax match ansibleJinjaComment /{#.\{-}#}/  containedin=ALL
  highlight default link ansibleJinjaExpr    PreProc
  highlight default link ansibleJinjaStmt    Statement
  highlight default link ansibleJinjaComment Comment
endfunction

augroup InfraSyntaxFallbacks
  autocmd!
  autocmd FileType nix call s:NixSyntax()
  autocmd Syntax * if &filetype ==# 'yaml.ansible' | call s:AnsibleSyntax() | endif
augroup END

" ============================================================
"  Commenting — gcc / gc{motion} / gc (visual) / gbc / gb{motion} / gb (visual)
" ============================================================

" Line-comment strings for infra filetypes (Vim's own ftplugins cover the rest)
augroup CommentStrings
  autocmd!
  autocmd FileType nix,yaml,toml,dockerfile,systemd,terraform,hcl,nginx,sudoers,sshconfig,sshdconfig,nftables,puppet,conf
        \ setlocal commentstring=#\ %s
  autocmd FileType jinja   setlocal commentstring={#\ %s\ #}
  autocmd FileType groovy  setlocal commentstring=//\ %s
augroup END

" Block-comment markers per filetype. Filetypes not listed here (sh, yaml,
" python, systemd, ...) have no block syntax, so gbc falls back to line comments.
let s:block = {
      \ 'c': ['/*','*/'],  'cpp': ['/*','*/'], 'java': ['/*','*/'], 'go': ['/*','*/'],
      \ 'rust': ['/*','*/'], 'javascript': ['/*','*/'], 'typescript': ['/*','*/'],
      \ 'css': ['/*','*/'], 'scss': ['/*','*/'], 'php': ['/*','*/'], 'sql': ['/*','*/'],
      \ 'nix': ['/*','*/'], 'terraform': ['/*','*/'], 'hcl': ['/*','*/'],
      \ 'groovy': ['/*','*/'], 'puppet': ['/*','*/'],
      \ 'html': ['<!--','-->'], 'xml': ['<!--','-->'], 'markdown': ['<!--','-->'],
      \ 'lua': ['--[[',']]'], 'jinja': ['{#','#}'], 'haskell': ['{-','-}']}

function! s:CmtParts() abort
  let l:cs = &commentstring
  if l:cs !~# '%s' | let l:cs = '# %s' | endif
  let l:i = stridx(l:cs, '%s')
  let l:lc = trim(strpart(l:cs, 0, l:i))
  let l:rc = trim(strpart(l:cs, l:i + 2))
  return [l:lc ==# '' && l:rc ==# '' ? '#' : l:lc, l:rc]
endfunction

function! s:BlockMarks() abort
  for l:f in split(&filetype, '\.')
    if has_key(s:block, l:f) | return s:block[l:f] | endif
  endfor
  let [l:a, l:b] = s:CmtParts()
  return l:b !=# '' ? [l:a, l:b] : []
endfunction

" Toggle line comments over [l1, l2]
function! s:ToggleLines(l1, l2) abort
  let [l:lc, l:rc] = s:CmtParts()
  let l:nums = filter(range(a:l1, a:l2), 'getline(v:val) =~# "\\S"')
  if empty(l:nums) | return | endif
  let l:view = winsaveview()
  let l:pl = '^\s*\V' . escape(l:lc, '\')
  let l:pr = '\V' . escape(l:rc, '\') . '\m\s*$'
  let l:all = 1
  for l:n in l:nums
    let l:txt = getline(l:n)
    if l:txt !~# l:pl || (l:rc !=# '' && l:txt !~# l:pr)
      let l:all = 0
      break
    endif
  endfor
  if l:all
    for l:n in l:nums
      let l:txt = substitute(getline(l:n), '^\(\s*\)\V' . escape(l:lc, '\') . '\m\s\?', '\1', '')
      if l:rc !=# ''
        let l:txt = substitute(l:txt, '\m\s\?\V' . escape(l:rc, '\') . '\m\s*$', '', '')
      endif
      call setline(l:n, l:txt)
    endfor
  else
    let l:ind = min(map(copy(l:nums), 'strlen(matchstr(getline(v:val), "^\\s*"))'))
    for l:n in l:nums
      let l:txt = getline(l:n)
      let l:txt = strpart(l:txt, 0, l:ind) . l:lc . ' ' . strpart(l:txt, l:ind)
      if l:rc !=# '' | let l:txt .= ' ' . l:rc | endif
      call setline(l:n, l:txt)
    endfor
  endif
  call winrestview(l:view)
endfunction

" Toggle ONE block comment wrapping [l1, l2]: opener on the first line,
" closer at the end of the last line
function! s:ToggleBlock(l1, l2) abort
  let l:m = s:BlockMarks()
  if empty(l:m)
    call s:ToggleLines(a:l1, a:l2)
    return
  endif
  let [l:o, l:c] = l:m
  let l:nums = filter(range(a:l1, a:l2), 'getline(v:val) =~# "\\S"')
  if empty(l:nums) | return | endif
  let l:first = l:nums[0]
  let l:last  = l:nums[-1]
  let l:view = winsaveview()
  if getline(l:first) =~# '^\s*\V' . escape(l:o, '\')
        \ && getline(l:last) =~# '\V' . escape(l:c, '\') . '\m\s*$'
    call setline(l:first, substitute(getline(l:first),
          \ '^\(\s*\)\V' . escape(l:o, '\') . '\m\s\?', '\1', ''))
    call setline(l:last, substitute(getline(l:last),
          \ '\m\s\?\V' . escape(l:c, '\') . '\m\s*$', '', ''))
  else
    let l:txt = getline(l:first)
    let l:ind = strlen(matchstr(l:txt, '^\s*'))
    call setline(l:first, strpart(l:txt, 0, l:ind) . l:o . ' ' . strpart(l:txt, l:ind))
    call setline(l:last, getline(l:last) . ' ' . l:c)
  endif
  call winrestview(l:view)
endfunction

function! s:OpLines(type) abort
  call s:ToggleLines(line("'["), line("']"))
endfunction
function! s:OpBlock(type) abort
  call s:ToggleBlock(line("'["), line("']"))
endfunction

" gcc  = toggle line comment (3gcc = 3 lines)
nnoremap <silent> gcc :<C-u>call <SID>ToggleLines(line('.'), min([line('$'), line('.') + v:count1 - 1]))<CR>
" gc{motion} = toggle line comments over a motion (gcap, gcip, gc5j ...)
nnoremap <silent> gc :set operatorfunc=<SID>OpLines<CR>g@
" gc in visual mode
xnoremap <silent> gc :<C-u>call <SID>ToggleLines(line("'<"), line("'>"))<CR>

" gbc  = toggle block comment on the current line (3gbc wraps 3 lines in ONE block)
nnoremap <silent> gbc :<C-u>call <SID>ToggleBlock(line('.'), min([line('$'), line('.') + v:count1 - 1]))<CR>
" gb{motion} = block-comment a whole code block (gbap, gbip, gb}, gb5j ...)
nnoremap <silent> gb :set operatorfunc=<SID>OpBlock<CR>g@
" gb in visual mode
xnoremap <silent> gb :<C-u>call <SID>ToggleBlock(line("'<"), line("'>"))<CR>

" ---------- Files / undo ----------
silent! call mkdir(expand('~/.vim/undo'),   'p', 0700)
silent! call mkdir(expand('~/.vim/swap'),   'p', 0700)
silent! call mkdir(expand('~/.vim/backup'), 'p', 0700)
set undofile
set undodir=~/.vim/undo//
set directory=~/.vim/swap//
set backupdir=~/.vim/backup//

augroup RestorePos
  autocmd!
  autocmd BufReadPost * if line("'\"") > 1 && line("'\"") <= line("$") |
        \ exe "normal! g`\"" | endif
augroup END

augroup Trim
  autocmd!
  autocmd BufWritePre * if &ft !~# 'markdown\|diff' |
        \ let s:v = winsaveview() | keeppatterns %s/\s\+$//e | call winrestview(s:v) | endif
augroup END

