" ============================================================
"  ~/.vimrc — Vim 9.1, zero plugins, built-in Catppuccin, kitty-tuned
" ============================================================
set nocompatible
let mapleader = " "
let g:cat_flavour = 'mocha'          " mocha | latte  (toggle with <leader>t)

" ---------- kitty: plain Esc, clean alternate screen, truecolor, undercurl ----------
if &term ==# 'xterm-kitty'
  let &t_TI = ""                     " don't enable kitty keyboard protocol
  let &t_TE = ""
  let &t_ti = "\e[?1049h"            " alternate screen on
  let &t_te = "\e[?1049l"            " alternate screen off -> clean exit
  let &t_8f = "\e[38;2;%lu;%lu;%lum"
  let &t_8b = "\e[48;2;%lu;%lu;%lum"
  let &t_Cs = "\e[4:3m"              " undercurl on
  let &t_Ce = "\e[4:0m"              " undercurl off
  let &t_8u = "\e[58:2:%lu:%lu:%lum"
endif
let &t_SI = "\e[6 q"                 " insert: bar
let &t_EI = "\e[2 q"                 " normal: block
let &t_SR = "\e[4 q"                 " replace: underline

filetype plugin indent on
syntax on
syntax sync minlines=300

" ---------- Core ----------
set encoding=utf-8
set hidden
set autoread
set updatetime=250
set timeout timeoutlen=600
set ttimeout ttimeoutlen=20
set backspace=indent,eol,start
set mouse=a
set history=1000
set belloff=all
if has('clipboard')
  set clipboard=unnamedplus
endif

" ---------- UI ----------
set number relativenumber
set cursorline
set cursorlineopt=number,screenline
set scrolloff=8
set sidescrolloff=8
set signcolumn=yes
set laststatus=2
set noshowmode
set showcmd
set wildmenu
set wildmode=longest:full,full
set wildoptions=pum
set splitbelow splitright
set synmaxcol=500
set list
set listchars=tab:»\ ,trail:·,nbsp:␣
let &fillchars = 'vert:│,fold:─,eob: '

" ---------- Soft wrapping (display only, never inserts newlines) ----------
set wrap
set linebreak
 set breakindent
" set breakindentopt=shift:2,min:20
" let &showbreak = '↪ '
set display+=lastline
set textwidth=0
set wrapmargin=0
set formatoptions-=t
set nojoinspaces
silent! set smoothscroll
augroup SoftWrap
  autocmd!
  " ftplugins love to set textwidth/auto-wrap; undo that everywhere
  autocmd FileType * setlocal wrap linebreak textwidth=0 wrapmargin=0 formatoptions-=t
augroup END
nnoremap <leader>z :set wrap!<CR>

