augroup InfraFiletypes
  autocmd!
  autocmd BufRead,BufNewFile *.nix                          setfiletype nix
  autocmd BufRead,BufNewFile flake.lock                     setfiletype json
  execute 'autocmd BufRead,BufNewFile *.tf,*.tfvars setfiletype ' . s:tf_ft
  autocmd BufRead,BufNewFile *.hcl,*.nomad                  setfiletype hcl
  autocmd BufRead,BufNewFile Dockerfile*,*.dockerfile,Containerfile* setfiletype dockerfile
  autocmd BufRead,BufNewFile Jenkinsfile*                   setfiletype groovy
  autocmd BufRead,BufNewFile Vagrantfile                    setfiletype ruby
  autocmd BufRead,BufNewFile *.pp                           setfiletype puppet
  " systemd units, networkd, podman quadlets
  autocmd BufRead,BufNewFile *.service,*.timer,*.socket,*.mount,*.automount,*.swap,*.path,*.slice,*.scope,*.target
        \ setfiletype systemd
  autocmd BufRead,BufNewFile */systemd/network/*.network,*/systemd/network/*.netdev,*/systemd/network/*.link
        \ setfiletype systemd
  autocmd BufRead,BufNewFile */containers/systemd/*         setfiletype systemd
