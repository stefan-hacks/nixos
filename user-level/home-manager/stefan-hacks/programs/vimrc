        \ set filetype=yaml.ansible
  " Services and system config
  autocmd BufRead,BufNewFile */nginx/*.conf,*/nginx/conf.d/*,*/nginx/sites-*/* setfiletype nginx
  autocmd BufRead,BufNewFile */sudoers.d/*                  setfiletype sudoers
  autocmd BufRead,BufNewFile */ssh/ssh_config.d/*,*/.ssh/config.d/* setfiletype sshconfig
  autocmd BufRead,BufNewFile */ssh/sshd_config.d/*          setfiletype sshdconfig
