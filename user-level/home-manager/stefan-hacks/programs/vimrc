nnoremap <leader>w :w<CR>
nnoremap <leader>q :q<CR>
nnoremap <leader>e :Lexplore<CR>
nnoremap <leader>\ :vsplit<CR>    " Split right
nnoremap <leader>- :split<CR>     " Split below
nnoremap <leader>b :ls<CR>:b<Space>
nnoremap <leader>f :find *

" Windows — navigate splits with leader
nnoremap <leader>h <C-w>h
nnoremap <leader>j <C-w>j
nnoremap <leader>k <C-w>k
nnoremap <leader>l <C-w>l

" Move selected lines
xnoremap J :m '>+1<CR>gv=gv
xnoremap K :m '<-2<CR>gv=gv

" Keep selection when indenting
xnoremap < <gv
xnoremap > >gv

" Wrapped-line movement
nnoremap <expr> j v:count ? 'j' : 'gj'
nnoremap <expr> k v:count ? 'k' : 'gk'
nnoremap <expr> 0 &wrap ? 'g0' : '0'
nnoremap <expr> $ &wrap ? 'g$' : '$'

nnoremap Y y$

command! W w
command! Q q
cnoremap w!! w !sudo tee % >/dev/null

" ---------- Netrw (bundled) ----------
let g:netrw_banner = 0
let g:netrw_liststyle = 3
let g:netrw_winsize = 25

" ---------- Statusline (colors follow the mode) ----------
let s:modes = {
      \ 'n': ['NORMAL',  'StlNormal'],  'i': ['INSERT',  'StlInsert'],
      \ 'v': ['VISUAL',  'StlVisual'],  'V': ['V-LINE',  'StlVisual'],
      \ "\<C-v>": ['V-BLOCK', 'StlVisual'], 's': ['SELECT', 'StlVisual'],
      \ 'R': ['REPLACE', 'StlReplace'], 'c': ['COMMAND', 'StlCommand'],
      \ 't': ['TERMINAL', 'StlInsert']}

function! StatusMode() abort
  let [l:name, l:grp] = get(s:modes, mode(), [mode(), 'StlNormal'])
  return '%#' . l:grp . '# ' . l:name . ' %#StlFile#'
endfunction

set statusline=%{%StatusMode()%}\ %f%m%r%h%w\ %#StlMid#%=%y\ %{&fileencoding?&fileencoding:&encoding}\ [%{&fileformat}]\ %#StlPos#\ %l:%c\ %p%%\

augroup StatusRefresh
  autocmd!
  autocmd ModeChanged * redrawstatus
augroup END

" ---------- Reset cursor shape on exit ----------
augroup CleanExit
  autocmd!
  autocmd VimLeave * silent! call writefile(["\e[0 q"], '/dev/tty', 'b')
augroup END
