" H(group, fg, bg [, attr]) — fg/bg are palette names or '' for NONE
function! s:H(group, fg, bg, ...) abort
  let l:attr = a:0 ? a:1 : 'NONE'
  let l:fg = a:fg ==# '' ? 'NONE' : get(s:p, a:fg, a:fg)
  let l:bg = a:bg ==# '' ? 'NONE' : get(s:p, a:bg, a:bg)
  execute printf('highlight %s guifg=%s guibg=%s gui=%s cterm=%s',
        \ a:group, l:fg, l:bg, l:attr, l:attr)
endfunction

