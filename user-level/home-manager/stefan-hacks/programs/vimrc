" ---------- Search ----------
set incsearch
set hlsearch
set ignorecase smartcase

" Manual clear (:nohlsearch keeps the option on, so n/N re-highlight)
nnoremap <silent> <Esc><Esc> :nohlsearch<CR>

" Auto-clear highlight when the cursor moves away from a search
let s:from_search = 0
function! s:Search(key) abort
  let s:from_search = 1
  return a:key
endfunction
function! s:AutoNoHl() abort
  if !v:hlsearch | return | endif
  if s:from_search
    let s:from_search = 0
  else
    call feedkeys("\<Cmd>nohlsearch\<CR>", 'n')
  endif
endfunction
for k in ['n', 'N', '*', '#', 'g*', 'g#', '/', '?']
  execute printf('nnoremap <expr> %s <SID>Search(%s)', k, string(k))
endfor
augroup AutoNoHl
  autocmd!
  autocmd CursorMoved * call s:AutoNoHl()
  autocmd InsertEnter * call feedkeys("\<Cmd>nohlsearch\<CR>", 'n')
augroup END

" ---------- Indentation ----------
